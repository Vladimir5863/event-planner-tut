// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event{
    id String @id @default(uuid()) @db.Uuid
    ownerUserId String @map("owner_user_id")
    title String
    description String?
    location String?
    eventDate DateTime @map("event_date") @db.Timestamp(6)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
    invite EventInvite?
    @@index([ownerUserId,createdAt(sort:Desc)],map:"idx_event_owner")
    @@map("events")
}

model EventInvite{
    id String @id @default(uuid()) @db.Uuid
    eventId String @unique @map("event_id") @db.Uuid
    token String @unique
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    event Event @relation(fields:[eventId],references:[id],onDelete: Cascade)
    @@map("event_invites")
}

enum RsvpStatus{
    going
    not_going
    maybe
}

model EventRsvp{
    id String @id @default(uuid()) @db.Uuid
    eventId String @map("event_id") @db.Uuid
    inviteId String @map("invite_id") @db.Uuid
    email String
    name String
    emailNormalized String @map("email_normalized")
    status RsvpStatus
    respondedAt DateTime @default(now()) @map("responded_at") @db.Timestamp(6)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
    //event Event @relation(fields:[eventId],references:[id],onDelete: Cascade)
    @@unique([eventId,emailNormalized])
    @@index([eventId,createdAt(sort:Desc)],map:"idx_event_rsvp_event")
    @@map("event_rsvps")
}
